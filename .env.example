# Copy to .env and adjust. All values are optional except the paths you care about.

# --- storage ---------------------------------------------------------------
# NAS share where downloads land (Plex/Jellyfin should read this same folder).
COVE_NAS_PATH=/volume1/media
# Host folder for Cove's SQLite state (the download queue).
COVE_CONFIG_PATH=./config

# --- network ---------------------------------------------------------------
COVE_PORT=5100

# --- behaviour -------------------------------------------------------------
COVE_MAX_CONCURRENT=3

# --- Claude (optional) -----------------------------------------------------
# Leave blank to run without AI features. Set to enable natural-language
# intake, the assistant chat panel, failure triage, and title cleanup.
ANTHROPIC_API_KEY=
