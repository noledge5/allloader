# Copy to .env and adjust. Everything except the storage paths is optional.

# --- storage ---------------------------------------------------------------
# NAS share where downloads land (Plex/Jellyfin should read this same folder).
COVE_NAS_PATH=/volume1/media
# Host folder for Cove's state (SQLite queue + Claude CLI config).
COVE_CONFIG_PATH=./config

# --- network ---------------------------------------------------------------
COVE_PORT=5100

# --- behaviour -------------------------------------------------------------
COVE_MAX_CONCURRENT=3

# --- image -----------------------------------------------------------------
# The CI-published image. Override to pin a specific commit tag if you like.
COVE_IMAGE=ghcr.io/noledge5/allloader:latest

# --- Claude (optional) -----------------------------------------------------
# Leave all three blank to run Cove without AI (everything else still works).
#
# Option A — use your Claude subscription (no per-token bill):
#   On any machine where you're logged into Claude Code, run:
#       claude setup-token
#   Paste the printed token here.
CLAUDE_CODE_OAUTH_TOKEN=
#
# Option B — use a metered Anthropic API key instead. If this is set it wins.
ANTHROPIC_API_KEY=
#
# "auto" (default) uses the API key when present, otherwise the subscription CLI.
# Force one with "api" or "cli".
COVE_AI_PROVIDER=auto
